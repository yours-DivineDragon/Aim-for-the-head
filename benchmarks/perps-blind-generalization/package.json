{
  "name": "meridian-clearing-blind-benchmark",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic blind security benchmark for a cross-margin perpetual clearing protocol",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "install:deterministic": "npm ci --ignore-scripts --cache /tmp/meridian-npm-cache",
    "compile": "node scripts/compile.mjs",
    "test": "node --test --test-concurrency=1 test/**/*.test.mjs",
    "check": "npm run compile && npm test",
    "manifest": "node scripts/manifest.mjs write",
    "manifest:verify": "node scripts/manifest.mjs verify",
    "seal:verify": "node scripts/verify-seal.mjs",
    "private:test": "node scripts/private-test.mjs"
  },
  "dependencies": {
    "ethers": "6.15.0",
    "ganache": "7.9.2",
    "solc": "0.8.30"
  }
}
