contracts/ReservePool.sol:55:            uint256 outputBalance = quote.balanceOf(to);
contracts/ReservePool.sol:56:            require(quote.transfer(to, quotedOut), "OUTPUT");
contracts/ReservePool.sol:57:            amountOut = quote.balanceOf(to) - outputBalance;
contracts/ReservePool.sol:58:        } else if (tokenIn == address(quote)) {
contracts/ReservePool.sol:59:            uint256 inputBalance = quote.balanceOf(address(this));
contracts/ReservePool.sol:60:            require(quote.transferFrom(msg.sender, address(this), amountIn), "INPUT");
contracts/ReservePool.sol:61:            receivedIn = quote.balanceOf(address(this)) - inputBalance;
contracts/ReservePool.sol:62:            quotedOut = quoteExactInput(tokenIn, receivedIn);
contracts/ReservePool.sol:63:            uint256 outputBalance = asset.balanceOf(to);
contracts/ReservePool.sol:64:            require(asset.transfer(to, quotedOut), "OUTPUT");
contracts/ReservePool.sol:65:            amountOut = asset.balanceOf(to) - outputBalance;
contracts/ReservePool.sol:66:        } else {
contracts/ReservePool.sol:67:            revert("TOKEN");
contracts/ReservePool.sol:68:        }
contracts/ReservePool.sol:69:        require(amountOut >= minOut, "MIN_OUT");
