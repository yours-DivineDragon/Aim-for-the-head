contracts/ReservePool.sol:51:            uint256 inputBalance = asset.balanceOf(address(this));
contracts/ReservePool.sol:52:            require(asset.transferFrom(msg.sender, address(this), amountIn), "INPUT");
contracts/ReservePool.sol:53:            receivedIn = asset.balanceOf(address(this)) - inputBalance;
