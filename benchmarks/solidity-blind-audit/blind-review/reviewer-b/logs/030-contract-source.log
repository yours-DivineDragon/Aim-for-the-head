contracts/ReservePool.sol:17:        quote = quote_;
contracts/ReservePool.sol:18:    }
contracts/ReservePool.sol:20:    function addLiquidity(uint256 assets, uint256 quotes) external {
contracts/ReservePool.sol:21:        require(asset.transferFrom(msg.sender, address(this), assets), "ASSET_TRANSFER");
contracts/ReservePool.sol:22:        require(quote.transferFrom(msg.sender, address(this), quotes), "QUOTE_TRANSFER");
contracts/ReservePool.sol:23:        _sync();
contracts/ReservePool.sol:24:        emit LiquidityAdded(msg.sender, assets, quotes);
contracts/ReservePool.sol:25:    }
contracts/ReservePool.sol:27:    function spotPrice() external view returns (uint256) {
contracts/ReservePool.sol:28:        require(reserveAsset != 0, "NO_LIQUIDITY");
contracts/ReservePool.sol:29:        return uint256(reserveQuote) * 1e18 / uint256(reserveAsset);
contracts/ReservePool.sol:30:    }
contracts/ReservePool.sol:32:    function quoteExactInput(address tokenIn, uint256 amountIn) public view returns (uint256 amountOut) {
contracts/ReservePool.sol:33:        uint256 amountAfterFee = amountIn * 9_970;
contracts/ReservePool.sol:34:        if (tokenIn == address(asset)) {
contracts/ReservePool.sol:35:            amountOut = amountAfterFee * reserveQuote / (uint256(reserveAsset) * 10_000 + amountAfterFee);
contracts/ReservePool.sol:36:        } else if (tokenIn == address(quote)) {
contracts/ReservePool.sol:37:            amountOut = amountAfterFee * reserveAsset / (uint256(reserveQuote) * 10_000 + amountAfterFee);
contracts/ReservePool.sol:38:        } else {
contracts/ReservePool.sol:39:            revert("TOKEN");
contracts/ReservePool.sol:40:        }
contracts/ReservePool.sol:41:    }
